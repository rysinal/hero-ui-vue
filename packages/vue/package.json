{
  "name": "@heroui-vue/vue",
  "version": "0.0.1",
  "description": "Beautiful and modern Vue 3 UI library built with Tailwind CSS 4.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@heroui-vue/styles": "workspace:*",
    "@internationalized/date": "^3.12.1",
    "@vueuse/core": "^11.3.0",
    "radix-vue": "^1.9.11",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@heroui-vue/standard": "workspace:*",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.8.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "peerDependencies": {
    "tailwindcss": ">=4.0.0",
    "vue": ">=3.4.0"
  }
}
