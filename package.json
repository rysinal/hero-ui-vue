{
  "name": "@heroui-vue/monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "HeroUI Vue 3 - Beautiful and modern Vue UI library. Docs: https://hero-ui-vue.pages.dev",
  "homepage": "https://hero-ui-vue.pages.dev",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @heroui-vue/storybook dev",
    "docs:dev": "vitepress dev apps/docs",
    "docs:build": "vitepress build apps/docs",
    "docs:preview": "vitepress preview apps/docs",
    "build": "turbo run build",
    "build:vue": "pnpm --filter @heroui-vue/vue build",
    "build:styles": "pnpm --filter @heroui-vue/styles build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,vue,js,jsx,json,css,md}\"",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.9",
    "eslint": "^9.17.0",
    "jsdom": "^29.1.0",
    "less": "^4.2.2",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.2.4",
    "turbo": "^2.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.0.7",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.8",
    "vue": "^3.5.33"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.9.0"
}
